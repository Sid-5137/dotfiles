/*
   Noctalia Pill (square) — colors follow the active Noctalia scheme.
   Colors come from noctalia-colors.rasi (generated by Noctalia).
*/
@import "noctalia-colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font Mono 12";
    background-color: transparent;
    text-color:       @nocta-fg;
    border-color:     transparent;
}

/* ── Window (floating, upper third) ──────── */
window {
    location:         center;
    anchor:           center;
    y-offset:         -170px;
    width:            460px;
    background-color: transparent;
    border:           0px;
    padding:          0px;
    children:         [mainbox];
}

mainbox {
    background-color: transparent;
    spacing:          10px;
    padding:          0px;
    children:         [inputbar, listview];
}

/* ── Search box ──────────────────────────── */
inputbar {
    background-color: @nocta-bg;
    border:           1px solid;
    border-color:     @nocta-border;
    border-radius:    0px;
    padding:          14px 20px;
    spacing:          12px;
    children:         [prompt, entry];
}

prompt {
    text-color:       @nocta-accent;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Mono 14";
}

entry {
    background-color:  transparent;
    text-color:        @nocta-fg;
    placeholder:       "Search apps";
    placeholder-color: @nocta-fg-dim;
    vertical-align:    0.5;
    cursor:            text;
    font:              "JetBrainsMono Nerd Font Mono 14";
}

/* ── Results (shrinks to matches) ────────── */
listview {
    background-color: @nocta-panel;
    border:           1px solid;
    border-color:     @nocta-border;
    border-radius:    0px;
    padding:          6px;
    spacing:          2px;
    lines:            6;
    columns:          1;
    dynamic:          true;
    scrollbar:        false;
    cycle:            true;
}

element {
    padding:          9px 14px;
    border-radius:    0px;
    background-color: transparent;
    spacing:          12px;
    orientation:      horizontal;
    border:           0px;
}

element normal.normal { background-color: transparent; text-color: @nocta-fg; }
element normal.urgent { background-color: transparent; text-color: @nocta-urgent; }
element normal.active { background-color: transparent; text-color: @nocta-accent; }

element selected.normal { background-color: @nocta-sel;    text-color: @nocta-fg; }
element selected.urgent { background-color: @nocta-urgent; text-color: @nocta-on-accent; }
element selected.active { background-color: @nocta-sel;    text-color: @nocta-accent; }

element-icon {
    background-color: transparent;
    size:             20px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Mono 12";
}

/* ── Message / Error ─────────────────────── */
message {
    background-color: @nocta-panel;
    border:           1px solid;
    border-color:     @nocta-border;
    border-radius:    0px;
    padding:          8px 14px;
}

textbox {
    background-color: transparent;
    text-color:       @nocta-accent;
    font:             "JetBrainsMono Nerd Font Mono 11";
}

error-message {
    background-color: @nocta-panel;
    border-radius:    0px;
    padding:          8px 14px;
}
