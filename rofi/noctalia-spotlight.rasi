/*
	 Noctalia Spotlight – solid selection, square, centered
*/

/* ── Palette ─────────────────────────────── */
* {
    bg:               rgba(20, 19, 20, 0.95);
    field:            rgba(71, 70, 76, 0.30);
    band:             rgba(32, 31, 34, 0.92);

    border-col:       rgba(218, 191, 206, 0.20);
    line-col:         rgba(145, 144, 150, 0.16);

    accent:           #dabfce;
    on-accent:        #141314;   /* dark text that sits on the accent fill */

    fg:               #c7c5ce;
    fg-bright:        #e5e1e3;
    fg-dim:           #919096;
    urgent:           #ffb4ab;

    font:             "JetBrainsMono Nerd Font Mono 12";
    background-color: transparent;
    text-color:       @fg;
    border-color:     transparent;
}

/* ── Window ──────────────────────────────── */
window {
    location:         center;
    anchor:           center;
    width:            560px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    0px;
    padding:          0px;
    children:         [mainbox];
}

mainbox {
    background-color: transparent;
    spacing:          0px;
    padding:          0px;
    children:         [inputbar, mode-switcher, listview];
}

/* ── Input Bar (filled search field) ─────── */
inputbar {
    background-color: @field;
    padding:          14px 16px;
    spacing:          12px;
    children:         [prompt, entry];
}

prompt {
    text-color:       @accent;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Mono 13";
}

entry {
    background-color: transparent;
    text-color:       @fg-bright;
    placeholder:      "Search";
    placeholder-color: @fg-dim;
    vertical-align:   0.5;
    cursor:           text;
    font:             "JetBrainsMono Nerd Font Mono 13";
}

/* ── Mode Switcher (solid active block) ──── */
mode-switcher {
    orientation:      horizontal;
    background-color: @band;
    border-top:       1px solid;
    border-bottom:    1px solid;
    border-color:     @line-col;
    padding:          6px 8px;
    spacing:          6px;
}

button {
    padding:          6px 14px;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @fg-dim;
    font:             "JetBrainsMono Nerd Font Mono 11";
    cursor:           pointer;
    horizontal-align: 0.5;
    border:           0px;
}

button selected {
    background-color: @accent;
    text-color:       @on-accent;
}

/* ── List View ───────────────────────────── */
listview {
    background-color: transparent;
    padding:          6px 0px;
    spacing:          0px;
    lines:            8;
    columns:          1;
    dynamic:          false;
    scrollbar:        false;
    cycle:            true;
}

/* ── Elements (contiguous full-width rows) ─ */
element {
    padding:          9px 16px;
    border-radius:    0px;
    background-color: transparent;
    spacing:          12px;
    orientation:      horizontal;
    border:           0px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:       @accent;
}

element selected.normal {
    background-color: @accent;
    text-color:       @on-accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @on-accent;
}

element selected.active {
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    background-color: transparent;
    size:             22px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Mono 12";
}

/* ── Message / Error ─────────────────────── */
message {
    background-color: @band;
    border-top:       1px solid;
    border-color:     @line-col;
    padding:          8px 16px;
}

textbox {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Mono 11";
}

error-message {
    background-color: @band;
    padding:          8px 16px;
}
